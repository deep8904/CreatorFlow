# Supabase project settings — find these in your Supabase project's
# Settings > API page. Safe to expose to the browser (NEXT_PUBLIC_*).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — full-privilege, bypasses Row Level Security. Server-side
# only (used by the delete-account/get-integrations/disconnect-integration
# edge functions and any other privileged server code). Never expose this to
# the browser or commit a real value anywhere.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Only used by scripts/seed-demo-data.ts — required, no default, so a demo
# password can never end up hardcoded in a committed file.
DEMO_ACCOUNT_EMAIL=
DEMO_ACCOUNT_PASSWORD=
